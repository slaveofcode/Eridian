{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eridian",
  "version": "0.3.3",
  "identifier": "com.velmlabs.eridian",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Eridian",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/slaveofcode/Eridian/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzMjg5OTBEQTU1MkJDNEEKUldSS3ZGS2xEWmtva3l2TUVQUmxxa2JFRWVKdE8yK1BNdFZjZ1RqRGo1ZDcrelJmNFZsSjgrQzcK"
    }
  }
}
